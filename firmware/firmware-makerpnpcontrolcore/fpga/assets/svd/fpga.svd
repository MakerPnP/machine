            </field>

            <field>
              <name>prescaler</name>
              <description>divide-1: the counter advances one tick every (prescaler+1) sys_clk cycles</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved1</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>16</bitOffset>
