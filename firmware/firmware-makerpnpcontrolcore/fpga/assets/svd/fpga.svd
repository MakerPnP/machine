    <!-- timer_pwm block (0x0e00 - 0x0eff) -->
    <peripheral>
      <name>timer_pwm</name>
      <description>4 independent 8-bit timers (source clock, 8-bit prescaler, 8-bit auto-reload) feeding 12 flexibly-mapped PWM output channels (PM1-4, OT1-8)</description>
      <baseAddress>0x90000e00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>

      <registers>

        <register>
          <name>pwm_ctrl</name>
          <description>master PWM output control - disabling forces every one of the 12 PWM pins LOW regardless of per-channel enable/polarity, and drives ot_en to its inactive (isolated) level</description>
          <addressOffset>0x0000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>output_enable</name>
              <description>1 = PWM outputs active and ot_en drives OT1-8's isolation buffer enabled; 0 (reset default) = every PWM pin forced LOW and OT1-8 electrically isolated</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim_sync</name>
          <description>global timer counting gate - lets every configured timer be started phase-aligned on the same sys_clk edge, plus a shared prescaler ahead of all 4 timers' own prescalers</description>
          <addressOffset>0x0004</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = every timer with its own timN_ctrl.enable set counts; 0 (reset default) = no timer counts, regardless of its own enable bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>prescaler</name>
              <description>divide-1, shared by all 4 timers ahead of each timer's own timN_ctrl.prescaler: a timer only advances on a sys_clk cycle this shared stage ticks on, so the effective divide to one timer tick is (prescaler+1) * (timN_ctrl.prescaler+1) sys_clk cycles. Parked at this value (not counting) whenever enable=0, so every timer's phase relative to it is deterministic the instant sync starts</description>
              <bitOffset>2</bitOffset>
              <bitWidth>6</bitWidth>
            </field>

            <field>
              <name>reserved1</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim1_ctrl</name>
          <description>timer 1 control</description>
          <addressOffset>0x0008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = this timer counts (subject to tim_sync.enable)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reset</name>
              <description>write 1 to reset this timer's counter to 0. self-clearing, always reads back 0</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>2</bitOffset>
              <bitWidth>6</bitWidth>
            </field>

            <field>
              <name>prescaler</name>
              <description>divide-1: the counter advances one tick every (prescaler+1) sys_clk cycles</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved1</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim1_arr</name>
          <description>timer 1 auto-reload value - the counter wraps to 0 the tick after reaching this value</description>
          <addressOffset>0x000c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>auto-reload value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim1_cnt</name>
          <description>timer 1 current counter value - also host-writable, to set an initial counter value before starting via tim_sync</description>
          <addressOffset>0x0010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>current counter value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim2_ctrl</name>
          <description>timer 2 control</description>
          <addressOffset>0x0014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = this timer counts (subject to tim_sync.enable)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reset</name>
              <description>write 1 to reset this timer's counter to 0. self-clearing, always reads back 0</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>2</bitOffset>
              <bitWidth>6</bitWidth>
            </field>

            <field>
              <name>prescaler</name>
              <description>divide-1: the counter advances one tick every (prescaler+1) sys_clk cycles</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved1</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim2_arr</name>
          <description>timer 2 auto-reload value - the counter wraps to 0 the tick after reaching this value</description>
          <addressOffset>0x0018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>auto-reload value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim2_cnt</name>
          <description>timer 2 current counter value - also host-writable, to set an initial counter value before starting via tim_sync</description>
          <addressOffset>0x001c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>current counter value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim3_ctrl</name>
          <description>timer 3 control</description>
          <addressOffset>0x0020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = this timer counts (subject to tim_sync.enable)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reset</name>
              <description>write 1 to reset this timer's counter to 0. self-clearing, always reads back 0</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>2</bitOffset>
