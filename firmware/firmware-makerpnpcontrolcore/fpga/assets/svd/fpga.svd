          <description>timer 4 auto-reload value - the counter wraps to 0 the tick after reaching this value</description>
          <addressOffset>0x0030</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>auto-reload value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>tim4_cnt</name>
          <description>timer 4 current counter value - also host-writable, to set an initial counter value before starting via tim_sync</description>
          <addressOffset>0x0034</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>current counter value</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>pwm_ctrl1</name>
          <description>PWM channel 1 (PM1) control</description>
          <addressOffset>0x0038</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = this channel drives its pin from its selected timer's comparator; 0 (reset default) = pin forced LOW regardless of polarity</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>polarity</name>
              <description>1 (inverted) = pin LOW while counter &lt; compare, HIGH once counter &gt;= compare; 0 (normal) = pin HIGH while counter &lt; compare, LOW once counter &gt;= compare. Either way the active phase is the first `compare` ticks of the period, and the pin returns to that active level the instant the timer's counter resets to 0 (auto-reload wrap or an explicit timN_ctrl.reset)</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>

            <field>
              <name>timer_src</name>
              <description>which of the 4 timers this channel compares against</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>

                <enumeratedValue>
                  <name>TIM1</name>
                  <description>compare against timer 1's counter</description>
                  <value>0</value>
                </enumeratedValue>

                <enumeratedValue>
                  <name>TIM2</name>
                  <description>compare against timer 2's counter</description>
                  <value>1</value>
                </enumeratedValue>

                <enumeratedValue>
                  <name>TIM3</name>
                  <description>compare against timer 3's counter</description>
                  <value>2</value>
                </enumeratedValue>

                <enumeratedValue>
                  <name>TIM4</name>
                  <description>compare against timer 4's counter</description>
                  <value>3</value>
                </enumeratedValue>

              </enumeratedValues>
            </field>

            <field>
              <name>reserved1</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>6</bitOffset>
              <bitWidth>26</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>pwm_cmp1</name>
          <description>PWM channel 1 (PM1) compare value</description>
          <addressOffset>0x003c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>8-bit compare value, compared against the selected timer's counter</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>

            <field>
              <name>reserved</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>

          </fields>
        </register>

        <register>
          <name>pwm_ctrl2</name>
          <description>PWM channel 2 (PM2) control</description>
          <addressOffset>0x0040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>enable</name>
              <description>1 = this channel drives its pin from its selected timer's comparator; 0 (reset default) = pin forced LOW regardless of polarity</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>polarity</name>
              <description>1 (inverted) = pin LOW while counter &lt; compare, HIGH once counter &gt;= compare; 0 (normal) = pin HIGH while counter &lt; compare, LOW once counter &gt;= compare. Either way the active phase is the first `compare` ticks of the period, and the pin returns to that active level the instant the timer's counter resets to 0 (auto-reload wrap or an explicit timN_ctrl.reset)</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>

            <field>
              <name>reserved0</name>
              <description>reserved, keep at reset value</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
            </field>

            <field>
              <name>timer_src</name>
              <description>which of the 4 timers this channel compares against</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
