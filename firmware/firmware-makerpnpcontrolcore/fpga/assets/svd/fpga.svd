        </register>

        <register>
          <name>tim3_arr</name>
          <description>timer 3 auto-reload value - the counter wraps to 0 the tick after reaching this value</description>
          <addressOffset>0x0024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>

            <field>
              <name>value</name>
              <description>auto-reload value</description>
              <bitOffset>0</bitOffset>
